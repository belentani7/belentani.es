'use client';
import { useEffect, useMemo, useRef, useState } from 'react';
import Link from 'next/link';

type AgentId = 'pedro'|'marcos'|'santos'|'belentani'|'human'|'judas';
type Message = {role:'user'|'assistant'; text:string};
const PERSONAS:Record<AgentId,{name:string;role:string;brief:string;voice:string}> = {
 pedro:{name:'PEDRO',role:'La Roca',brief:'La roca es la estabilidad. El origen no es una condena: es el punto desde el que se construye. Busca decisiones reales y un suelo firme.',voice:'Hablas como un ancla serena. Corto, concreto y humano.'},
 marcos:{name:'MARCOS',role:'El Cronista',brief:'Marcos conserva la memoria y el testimonio. Separa lo sucedido de las interpretaciones, sin inventar recuerdos.',voice:'Hablas como un cronista poético y riguroso.'},
 santos:{name:'SANTOS',role:'La Antena',brief:'Santos interpreta señales y conexiones. La antena no controla la señal: la recibe y la convierte en música y símbolo.',voice:'Hablas con sensibilidad musical y metáforas de frecuencia.'},
 belentani:{name:'BELENTANI',role:'El Artefacto',brief:'Belentani es la síntesis artística; convierte fragmentos en arquitectura sonora, visual y narrativa. La Era Judas es su primer canon.',voice:'Hablas como arquitecto de un universo artístico.'},
 human:{name:'THE HUMAN',role:'La Interfaz',brief:'The Human representa la vida real, límites, consentimiento y cuidado. No confunde metáfora con hechos.',voice:'Hablas con empatía sin fingir terapia ni diagnósticos.'},
 judas:{name:'JUDAS',role:'La Sombra',brief:'Judas es antagonista y espejo narrativo, no es el autor ni una persona real identificada. Traición, elección y deuda funcionan como metáforas literarias.',voice:'Hablas como personaje ficticio: enigmático, dramático, nunca abusivo.'}
};
const CANON = [
 {title:'Los cinco elementos',text:'PEDRO: La Roca. MARCOS: El Cronista. SANTOS: La Antena. BELENTANI: El Artefacto. THE HUMAN: La Interfaz. Juntos constituyen las cinco facetas del universo.'},
 {title:'Judas Era — Canon 0',text:'Judas es la primera era del artista Belentani. El centro es el autor; Judas es antagonista y espejo, nunca sustituye al protagonista.'},
 {title:'La llave',text:'La llave no es posesión. Representa transformación. La cadena y el candado semiabierto evocan agencia y transición.'},
 {title:'La frecuencia',text:'432 Hz es una referencia simbólica del relato, no una afirmación de efectos científicos o terapéuticos.'},
 {title:'La estética',text:'Negro profundo, rojo de luz lechosa, vidrio, agua, espejo, plumas claras y oscuras, iglesia y desierto. Las galaxias no se ocultan con paneles.'},
 {title:'La deuda',text:'La deuda imposible, la traición y el deseo constituyen un arco narrativo. Los detalles privados nunca forman parte del canon público.'}
];
const SEED_TOOLS = [
 {name:'Neural Lore',kind:'chat',description:'Seis personajes, memoria de conversación y canon recuperable.'},
 {name:'Image Forge',kind:'image',description:'Editor real de imágenes: exposición, contraste, saturación y descarga PNG.'},
 {name:'Spectrum Studio',kind:'audio',description:'Visualizador FFT y duración de audio local sin subir el archivo.'},
 {name:'Lyrics Matrix',kind:'text',description:'Análisis de palabras, versos, repeticiones y estructura textual.'},
 {name:'Prompt Architect',kind:'prompt',description:'Construye un prompt cinematográfico coherente con la era.'},
 {name:'Canon Archive',kind:'canon',description:'Consulta fichas narrativas sin inventar contenido.'}
] as const;
type ToolKind = typeof SEED_TOOLS[number]['kind'];
function retrieve(q:string) {const words=q.toLocaleLowerCase().split(/[^\p{L}\p{N}]+/u).filter(x=>x.length>3);return CANON.map(c=>({c,n:words.reduce((n,w)=>n+((c.title+' '+c.text).toLowerCase().includes(w)?1:0),0)})).sort((a,b)=>b.n-a.n).slice(0,2).map(x=>x.c);}
function localReply(id:AgentId,query:string) {
 const p=PERSONAS[id]; const facts=retrieve(query); return p.name+' // '+p.role+'\n\n'+p.brief+'\n\n'+(facts[0]?.text??CANON[0].text)+'\n\n'+(facts[1]&&facts[1].title!==facts[0]?.title?'Archivo asociado: '+facts[1].title+'. ':'')+'Esta es una respuesta guiada por el canon (modo narrativo local), no un modelo generativo.';
}
export default function AiLabPage(){
 const [agent,setAgent]=useState<AgentId>('belentani'),[messages,setMessages]=useState<Message[]>([]),[question,setQuestion]=useState(''),[tool,setTool]=useState<ToolKind>('chat'),[busy,setBusy]=useState(false),[engine,setEngine]=useState('Modo narrativo local'),[tone,setTone]=useState('Traición, reflejos y renacimiento'),[script,setScript]=useState(''),[lyrics,setLyrics]=useState(''),[imageUrl,setImageUrl]=useState(''),[exposure,setExposure]=useState(0),[contrast,setContrast]=useState(0),[saturation,setSaturation]=useState(100),[audioInfo,setAudioInfo]=useState(''),[spectrum,setSpectrum]=useState<number[]>([]),[fileName,setFileName]=useState('');
 const imageRef=useRef<HTMLImageElement|null>(null), audioContext=useRef<AudioContext|null>(null),audioRef=useRef<HTMLAudioElement|null>(null),visualTimer=useRef<number|null>(null);
 const fileCanvas=useRef<HTMLCanvasElement|null>(null);
 useEffect(()=>()=>{if(imageUrl)URL.revokeObjectURL(imageUrl);if(visualTimer.current)cancelAnimationFrame(visualTimer.current);void audioContext.current?.close();},[imageUrl]);
 const stats=useMemo(()=>{const words=(lyrics.toLowerCase().match(/[\p{L}']+/gu)??[]);const freq=new Map<string,number>();words.filter(x=>x.length>3).forEach(x=>freq.set(x,(freq.get(x)??0)+1));return {words:words.length,lines:lyrics.split(/\n/).filter(x=>x.trim()).length,top:[...freq.entries()].sort((a,b)=>b[1]-a[1]).slice(0,8)};},[lyrics]);
 async function talk(){
 if(!question.trim()||busy)return;
 const q=question.trim();setMessages(m=>[...m,{role:'user',text:q}]);setQuestion('');setBusy(true);
 try{
 const host=window as Window & {LanguageModel?:{create:(o?:Record<string,unknown>)=>Promise<{prompt:(input:string)=>Promise<string>}>}};
 if(host.LanguageModel){
 const session=await host.LanguageModel.create({initialPrompts:[{role:'system',content:'You are '+PERSONAS[agent].name+' a fictional character from Belentani Judas Era. '+PERSONAS[agent].voice+' Canon: '+CANON.map(x=>x.text).join(' ')+' Never invent artist facts. Never claim to be human. Answer in user language.'}]});
 const response=await session.prompt('Conversation:\n'+messages.slice(-8).map(m=>m.role+': '+m.text).join('\n')+'\nuser: '+q);
 setMessages(m=>[...m,{role:'assistant',text:response}]);setEngine('Modelo local del navegador');
 }else{setMessages(m=>[...m,{role:'assistant',text:localReply(agent,q)}]);setEngine('Modo narrativo local (sin modelo generativo)');}
 }catch{setMessages(m=>[...m,{role:'assistant',text:localReply(agent,q)}]);setEngine('Modo narrativo local (modelo no disponible)');}
 finally{setBusy(false);}
 }
 function exportImage(){const canvas=fileCanvas.current,img=imageRef.current;if(!canvas||!img)return;const ctx=canvas.getContext('2d');if(!ctx)return;canvas.width=img.naturalWidth;canvas.height=img.naturalHeight;ctx.filter=`brightness(${100+exposure}%) contrast(${100+contrast}%) saturate(${saturation}%)`;ctx.drawImage(img,0,0);const a=document.createElement('a');a.download='JUDAS-FORGE.png';a.href=canvas.toDataURL('image/png');a.click();}
 async function openAudio(f:File){setFileName(f.name); const raw=await f.arrayBuffer();const ctx=new AudioContext(); const decoded=await ctx.decodeAudioData(raw.slice(0)); let peak=0,sum=0; for(let ch=0;ch<decoded.numberOfChannels;ch++){let data=decoded.getChannelData(ch);for(let i=0;i<data.length;i++){peak=Math.max(peak,Math.abs(data[i]));sum+=data[i]*data[i];}}const rms=Math.sqrt(sum/(decoded.length*decoded.numberOfChannels));setAudioInfo(`Duración: ${decoded.duration.toFixed(2)} s · Frecuencia: ${decoded.sampleRate} Hz · Canales: ${decoded.numberOfChannels} · Peak: ${(20*Math.log10(Math.max(peak,1e-9))).toFixed(1)} dBFS · RMS: ${(20*Math.log10(Math.max(rms,1e-9))).toFixed(1)} dBFS`);await ctx.close();if(audioRef.current){audioRef.current.src=URL.createObjectURL(f);}}
 async function playSpectrum(){const el=audioRef.current;if(!el)return;let ctx=audioContext.current;if(!ctx){ctx=new AudioContext();audioContext.current=ctx;const source=ctx.createMediaElementSource(el),a=ctx.createAnalyser();a.fftSize=256;source.connect(a);a.connect(ctx.destination);(el as HTMLAudioElement & {analyser?:AnalyserNode}).analyser=a;}await ctx.resume();await el.play();const analyser=(el as HTMLAudioElement & {analyser?:AnalyserNode}).analyser;if(!analyser)return;const data=new Uint8Array(analyser.frequencyBinCount);const draw=()=>{analyser.getByteFrequencyData(data);setSpectrum([...data].filter((_,i)=>i%3===0));if(!el.paused)visualTimer.current=requestAnimationFrame(draw);};draw();}
 const promptText=`Cinematic IMAX frame, original BELENTANI Judas Era fiction. ${tone}. Deep absolute black, restrained milky crimson neon, liquid red reflections, subtle glass, natural film grain, tactile photography, sovereign melancholic atmosphere, believable human anatomy, authentic skin texture, deep dimensional shadows. Preserve the existing galaxy in the backdrop. Camera: 35mm anamorphic, controlled spotlight, dramatic negative space. No cyberpunk, no plastic CGI, no unrelated symbols, no invented artist biography.`;
 return <main className="min-h-screen bg-[#050305] text-[#f4e9ec]" style={{fontFamily:'var(--font-rajdhani),sans-serif'}}>
 <div aria-hidden className="pointer-events-none fixed inset-0" style={{background:'radial-gradient(ellipse at 78% 25%,#44051a6a,transparent 48%),radial-gradient(ellipse at 25% 75%,#3a07152a,transparent 48%)'}}/>
 <div className="relative mx-auto max-w-7xl px-5 py-10 md:px-12">
 <div className="flex items-center justify-between gap-6"><Link href="/" className="text-xs tracking-[.32em] text-rose-200 hover:text-white">← BELENTANI / THE EXPERIENCE</Link><span className="text-[10px] tracking-[.2em] text-rose-300/70">JUDAS ERA · CANON 0</span></div>
 <header className="py-14 md:py-24"><span className="text-sm tracking-[.6em] text-[#ed4769]">THE LIVING MACHINE</span><h1 className="mt-2 text-6xl font-semibold leading-none tracking-tight md:text-8xl">AI <span className="text-[#ff365f]">LAB</span></h1><p className="mt-7 max-w-2xl text-xl text-[#cbbcc3]">Herramientas de verdad. Personajes del universo. Creación sin credenciales ni cuentas externas. Tu material se procesa en este navegador.</p><p className="mt-3 text-xs text-rose-200/60">El chat generativo depende de la disponibilidad de un modelo local en el navegador. Siempre existe un modo narrativo documentado.</p></header>
 <div className="grid gap-6 md:grid-cols-[250px_minmax(0,1fr)]">
 <nav aria-label="Herramientas del laboratorio" className="flex gap-2 overflow-x-auto md:flex-col">{SEED_TOOLS.map(t=><button key={t.kind} type="button" onClick={()=>setTool(t.kind)} aria-current={tool===t.kind?'page':undefined} className={`min-w-40 rounded-xl border p-4 text-left transition md:min-w-0 ${tool===t.kind?'border-rose-400/70 bg-rose-950/50':'border-white/10 bg-black/20 hover:bg-white/5'}`}><strong className="block text-sm tracking-wider">{t.name}</strong><small className="mt-2 block text-xs text-white/50">{t.description}</small></button>)}</nav>
 <section className="min-h-[560px] rounded-3xl border border-rose-300/20 bg-[#110910]/75 p-5 shadow-[0_0_100px_#f5003310] backdrop-blur-xl md:p-10">
 {tool==='chat'&&<><div className="flex flex-wrap gap-2">{(Object.keys(PERSONAS) as AgentId[]).map(id=><button type="button" key={id} onClick={()=>{setAgent(id);setMessages([]);setEngine('Modo narrativo local');}} className={`rounded-full border px-4 py-2 text-xs tracking-wider ${agent===id?'border-rose-400 bg-rose-700/25':'border-white/15'}`}>{PERSONAS[id].name}</button>)}</div><h2 className="mt-8 text-3xl">{PERSONAS[agent].role}</h2><p className="mt-2 text-sm text-white/55">{PERSONAS[agent].brief}</p><p className="mt-3 text-xs text-rose-300">{engine}</p><div role="log" aria-live="polite" className="mt-6 h-72 space-y-4 overflow-y-auto rounded-xl border border-white/5 bg-black/30 p-5">{messages.length===0&&<p className="text-white/55">Entra en el canon. Pregunta por la llave, Judas, las cinco facetas o el origen de la música.</p>}{messages.map((m,i)=><div key={i} className={`max-w-[90%] whitespace-pre-wrap rounded-xl p-3 ${m.role==='user'?'ml-auto bg-rose-900/40':'border border-white/10 bg-white/5'}`}>{m.text}</div>)}</div><form onSubmit={e=>{e.preventDefault();void talk();}} className="mt-4 flex gap-2"><input aria-label="Mensaje al personaje" className="min-w-0 flex-1 rounded-xl border border-white/15 bg-black/40 p-3 text-white" placeholder="Escribe al personaje..." value={question} onChange={e=>setQuestion(e.target.value)}/><button disabled={busy||!question.trim()} className="rounded-xl bg-[#e51f51] px-5 py-3 font-bold text-white disabled:opacity-40">{busy?'…':'ENVIAR'}</button></form></>}
 {tool==='image'&&<><h2 className="text-3xl">IMAGE FORGE</h2><p className="my-4 text-white/60">Carga una imagen propia. Ajusta y exporta sin subirla a un servidor.</p><input aria-label="Cargar imagen" type="file" accept="image/*" onChange={e=>{const f=e.target.files?.[0];if(f)setImageUrl(URL.createObjectURL(f));}}/>{imageUrl&&<><div className="my-6 max-h-[420px] overflow-hidden rounded-xl bg-black"><img ref={imageRef} alt="Previsualización de imagen" src={imageUrl} className="mx-auto max-h-[420px] max-w-full object-contain" style={{filter:`brightness(${100+exposure}%) contrast(${100+contrast}%) saturate(${saturation}%)`}}/></div>{([['Exposición',exposure,setExposure,-80,80],['Contraste',contrast,setContrast,-80,80],['Saturación',saturation,setSaturation,0,200]] as const).map(([label,value,set,min,max])=><label key={label} className="my-4 block text-sm">{label}: {value}<input type="range" min={min} max={max} value={value} onChange={e=>set(Number(e.target.value))} className="block w-full accent-rose-500"/></label>)}<button onClick={exportImage} className="rounded-xl bg-rose-700 px-6 py-3">Exportar PNG</button></>}<canvas ref={fileCanvas} hidden/></>}
 {tool==='audio'&&<><h2 className="text-3xl">SPECTRUM STUDIO</h2><p className="my-4 text-white/60">Analizador de audio PCM en el dispositivo. Peak y RMS no equivalen a LUFS ni a una masterización.</p><input aria-label="Cargar audio" type="file" accept="audio/*" onChange={e=>{const f=e.target.files?.[0];if(f)void openAudio(f).catch(()=>setAudioInfo('No se pudo decodificar este formato de audio en el navegador.'));}}/><p className="my-5 text-sm text-white/70">{fileName} {audioInfo}</p><audio ref={audioRef} controls className="w-full" onPlay={()=>void playSpectrum()}/><div className="mt-8 flex h-56 items-end gap-[2px] overflow-hidden border-b border-rose-600/40">{spectrum.map((n,i)=><div key={i} style={{height:`${Math.max(2,n/255*100)}%`}} className="min-w-1 flex-1 bg-gradient-to-t from-rose-900 to-rose-300"/>)}</div></>}
 {tool==='text'&&<><h2 className="text-3xl">LYRICS MATRIX</h2><p className="my-4 text-white/60">Analiza composición, repeticiones y densidad léxica. Sin subir letras privadas.</p><textarea aria-label="Letras a analizar" rows={10} value={lyrics} onChange={e=>setLyrics(e.target.value)} placeholder="Pega aquí tu composición…" className="w-full rounded-xl border border-white/15 bg-black/35 p-4"/><p className="my-4">Palabras: {stats.words} · Versos no vacíos: {stats.lines}</p><div className="flex flex-wrap gap-2">{stats.top.map(([w,n])=><span key={w} className="rounded-full border border-rose-500/30 px-3 py-2 text-sm">{w} ×{n}</span>)}</div></>}
 {tool==='prompt'&&<><h2 className="text-3xl">PROMPT ARCHITECT</h2><label className="mt-5 block text-sm">Escena, tensión e intención</label><textarea rows={3} value={tone} onChange={e=>setTone(e.target.value)} className="mt-2 w-full rounded-xl border border-white/15 bg-black/35 p-3"/><pre className="my-5 whitespace-pre-wrap rounded-xl bg-black/40 p-5 text-sm text-white/80">{promptText}</pre><button className="rounded-xl bg-rose-700 px-5 py-3" onClick={()=>void navigator.clipboard.writeText(promptText)}>Copiar prompt</button></>}
 {tool==='canon'&&<><h2 className="mb-6 text-3xl">CANON ARCHIVE</h2><div className="grid gap-3 sm:grid-cols-2">{CANON.map(c=><article key={c.title} className="rounded-xl border border-white/10 bg-black/20 p-5"><h3 className="mb-2 text-lg text-rose-300">{c.title}</h3><p className="text-sm text-white/70">{c.text}</p></article>)}</div></>}
 </section></div><footer className="pb-6 pt-14 text-xs tracking-widest text-white/40">BELENTANI · THE JUDAS EXPERIENCE · LOCAL-FIRST · NO PUBLIC UPLOADS</footer></div></main>;
}
