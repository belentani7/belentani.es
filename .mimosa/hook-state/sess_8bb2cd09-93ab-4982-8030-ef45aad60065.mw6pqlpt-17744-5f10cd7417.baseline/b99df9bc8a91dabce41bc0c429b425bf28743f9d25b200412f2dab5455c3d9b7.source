'use client';
import {useMemo,useRef,useState} from 'react';
import Link from 'next/link';
type Agent='PEDRO'|'MARCOS'|'SANTOS'|'BELENTANI'|'THE HUMAN';
type Message={role:'you'|'agent';text:string};
const agents:Record<Agent,{role:string;intro:string;lines:string[]}> = {
PEDRO:{role:'La roca · estabilidad',intro:'Soy Pedro. La roca no impide la tormenta; permite sostenerse.',lines:['Pon nombre a lo que permanece. Una cosa. No toda una vida.','No necesitas resolver el universo para encontrar el siguiente apoyo.','El suelo también es un personaje de esta historia. ¿Qué se conserva?']},
MARCOS:{role:'El cronista · memoria',intro:'Soy Marcos. Registro lo que los espejos intentan borrar.',lines:['La memoria no dicta sentencia. Ordena fragmentos y deja constancia.','Dime qué sucedió primero y qué parte fue interpretación.','Un relato cambia cuando distinguimos testimonio, símbolo y ficción.']},
SANTOS:{role:'La antena · resonancia',intro:'Soy Santos. No invento señales: escucho las frecuencias.',lines:['Una frecuencia no es un destino. Es un pulso que puedes transformar.','Escucha la respiración de esta escena. ¿Qué sonido tendría?','La conexión no es posesión; aparece cuando alguien escucha de verdad.']},
BELENTANI:{role:'El artefacto · creación',intro:'Soy Belentani. La herida se convierte en arquitectura viva.',lines:['No es redención. Es transmutación. Convirtamos esa imagen en una escena.','Un símbolo merece una función: llave, espejo, pluma, cadena. Elige uno.','El escenario es negro, la luz es roja y la voz revela la estructura.']},
'THE HUMAN':{role:'La interfaz · integración',intro:'Soy The Human. Mi función es recordar que detrás del personaje hay una persona.',lines:['Los cinco elementos pueden coexistir sin convertirse en un diagnóstico.','Sal de la metáfora un segundo: ¿qué acción concreta sería útil ahora?','La interfaz vuelve al mundo real, donde las decisiones tienen consecuencias.']}
};
const commands=[
['Invertir texto','text'],['Mayúsculas','text'],['Minúsculas','text'],['Contar palabras','text'],['Slug SEO','text'],['Quitar duplicadas','text'],['Ordenar líneas','text'],['JSON bonito','code'],['Validar JSON','code'],['Base64 encode','code'],['Base64 decode','code'],['URL encode','code'],['URL decode','code'],['HTML escape','code'],['Texto a CSV','code'],['Paleta HEX','design'],['Contraste WCAG','design'],['Color complementario','design'],['Prompt de escena','lore'],['Concepto de canción','lore'],['Mapa de símbolos','lore'],['Tarot narrativo','lore'],['Detector de temas','lore'],['Estructura de versos','lore']
] as const;
const hf=[
{name:'Models',detail:'Explorar modelos abiertos',url:'https://huggingface.co/models'},
{name:'Spaces',detail:'Aplicaciones IA alojadas por sus autores',url:'https://huggingface.co/spaces'},
{name:'Transformers.js',detail:'Modelos ejecutados en el navegador',url:'https://huggingface.co/docs/transformers.js'},
{name:'ONNX Runtime Web',detail:'Inferencia local WebAssembly / WebGPU',url:'https://onnxruntime.ai/docs/get-started/with-javascript/web.html'},
{name:'Whisper',detail:'Explorar voz y transcripción',url:'https://huggingface.co/models?pipeline_tag=automatic-speech-recognition'},
{name:'Image-to-text',detail:'Visión abierta',url:'https://huggingface.co/models?pipeline_tag=image-to-text'},
{name:'Text-to-image',detail:'Generación visual en Spaces',url:'https://huggingface.co/spaces?sort=trending&search=text-to-image'},
{name:'Audio',detail:'Exploración de modelos sonoros',url:'https://huggingface.co/models?pipeline_tag=text-to-audio'}
];
function escapeHtml(s:string){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));}
function analyze(raw:string){const a=raw.toLowerCase();return ['traición','deuda','espejo','llave','voz','silencio','agua','luz','memoria','perdón','judas','sombra','rojo','cruz','escenario'].filter(s=>a.includes(s)).join(' · ')||'vacío · umbral · identidad';}
function toolRun(name:string,input:string){
const lines=input.split(/\r?\n/), words=input.trim().split(/\s+/).filter(Boolean);
switch(name){
case 'Invertir texto':return [...input].reverse().join('');
case 'Mayúsculas':return input.toLocaleUpperCase('es');
case 'Minúsculas':return input.toLocaleLowerCase('es');
case 'Contar palabras':return [words.length+' palabras',input.length+' caracteres',lines.length+' líneas',new Set(words.map(w=>w.toLowerCase())).size+' términos únicos'].join('\n');
case 'Slug SEO':return input.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
case 'Quitar duplicadas':return [...new Set(lines)].join('\n');
case 'Ordenar líneas':return lines.sort((a,b)=>a.localeCompare(b,'es')).join('\n');
case 'JSON bonito':return JSON.stringify(JSON.parse(input),null,2);
case 'Validar JSON':JSON.parse(input);return 'JSON válido · parseado correctamente';
case 'Base64 encode':return btoa(Array.from(new TextEncoder().encode(input),b=>String.fromCharCode(b)).join(''));
case 'Base64 decode':return new TextDecoder().decode(Uint8Array.from(atob(input.trim()),c=>c.charCodeAt(0)));
case 'URL encode':return encodeURIComponent(input);
case 'URL decode':return decodeURIComponent(input);
case 'HTML escape':return escapeHtml(input);
case 'Texto a CSV':return lines.map(l=>l.split(/\s{2,}|\t/).map(v=>'"'+v.replace(/"/g,'""')+'"').join(',')).join('\n');
case 'Paleta HEX':{const hits=input.match(/#[a-fA-F0-9]{6}\b/g)||[];return [...new Set(hits.map(v=>v.toUpperCase()))].join('\n')||'Escribe colores HEX de seis dígitos, p. ej. #FF1038';}
case 'Color complementario':{const h=input.match(/#[a-fA-F0-9]{6}\b/);if(!h)throw Error('Introduce un color como #FF1038');return '#'+[1,3,5].map(i=>(255-parseInt(h[0].slice(i,i+2),16)).toString(16).padStart(2,'0')).join('').toUpperCase();}
case 'Contraste WCAG':{const h=input.match(/#[a-fA-F0-9]{6}\b/g);if(!h||h.length<2)throw Error('Escribe dos colores HEX');const lum=(v:string)=>{const c=[1,3,5].map(i=>parseInt(v.slice(i,i+2),16)/255).map(n=>n<=.04045?n/12.92:((n+.055)/1.055)**2.4);return .2126*c[0]+.7152*c[1]+.0722*c[2]};let a=lum(h[0]),b=lum(h[1]);const ratio=(Math.max(a,b)+.05)/(Math.min(a,b)+.05);return 'Contraste '+ratio.toFixed(2)+':1\nTexto AA: '+(ratio>=4.5?'apto':'insuficiente')+'\nTexto grande AA: '+(ratio>=3?'apto':'insuficiente');}
case 'Prompt de escena':return 'JUDAS ERA / ESCENA\n\nMotivo: '+(input||'la llave y el espejo')+'\n\nCine negro profundo, neón rojo lechoso, reflejos líquidos, grano fotográfico orgánico, escala humana, escenografía monumental, luz volumétrica tenue, lentes cinematográficas, sin estética plástica. La cámara empieza inmóvil; el escenario se revela en capas. La imagen es simbólica, no documental. Sin texto incrustado.';
case 'Concepto de canción':return 'TÍTULO / '+(input.split('\n')[0]||'LA DEUDA')+'\nGénero: dark pop, R&B y electrónica experimental.\nConflicto: voz frente al silencio.\nVerso 1: recuerdo concreto.\nPre-coro: tensión en ascenso.\nCoro: una frase que funciona como llave.\nPuente: cambio de perspectiva.\nOutro: despedida serena, imposible de olvidar.';
case 'Mapa de símbolos':return 'NÚCLEO: '+(input||'Judas')+'\nPEDRO → soporte\nMARCOS → testimonio\nSANTOS → resonancia\nBELENTANI → transmutación\nTHE HUMAN → retorno\n\nSímbolos detectados: '+analyze(input);
case 'Tarot narrativo':{const deck=['El Espejo: confrontar la imagen','La Llave: recuperar agencia','La Antena: escuchar antes de interpretar','La Roca: encontrar apoyo','El Artefacto: transformar sin borrar'];const seed=[...input].reduce((a,c)=>a+c.charCodeAt(0),0);return [0,1,2].map((v)=>['ORIGEN','TENSIÓN','POSIBILIDAD'][v]+': '+deck[(seed+v*3)%deck.length]).join('\n')+'\n\nLectura creativa, no predicción.';}
case 'Detector de temas':return 'Motivos presentes: '+analyze(input)+'\nPalabras: '+words.length+'\nUso: anotación creativa, no evaluación psicológica.';
case 'Estructura de versos':return ['VERSO 1 — La escena',input||'[imagen principal]','PRECORO — La contradicción','CORO — La frase inevitable','VERSO 2 — La consecuencia','PUENTE — El espejo se invierte','OUTRO — Recuérdame'].join('\n');
default:return input;
}}
function answer(agent:Agent,text:string,index:number){const a=agents[agent];const lower=text.toLowerCase();let line=a.lines[index%a.lines.length];if(/quién|quien|eres|personaje/.test(lower))return a.intro+' '+line;if(/llave|espejo|deuda|judas/.test(lower))line='En este universo, '+(lower.includes('llave')?'la llave representa transformación, no posesión.':lower.includes('espejo')?'el espejo enfrenta al autor con su personaje.':lower.includes('deuda')?'la deuda es una metáfora de lo que no se puede devolver.':'Judas es una figura dramática, no una identidad real.')+' '+line;return line+'\n\n[Diálogo narrativo local · sin modelo generativo]';}
export default function LabPage(){
const [tab,setTab]=useState<'tools'|'agents'|'open'>('tools');
const [category,setCategory]=useState('all'),[filter,setFilter]=useState('');
const [selected,setSelected]=useState<string>(commands[0][0]),[input,setInput]=useState(''),[output,setOutput]=useState(''),[agent,setAgent]=useState<Agent>('BELENTANI'),[question,setQuestion]=useState(''),[history,setHistory]=useState<Partial<Record<Agent,Message[]>>>({});
const [image,setImage]=useState(''),[imageName,setImageName]=useState(''),[brightness,setBrightness]=useState(100),[contrast,setContrast]=useState(100),[saturation,setSaturation]=useState(100);
const fileRef=useRef<HTMLInputElement>(null);
const visible=useMemo(()=>commands.filter(([n,c])=>(category==='all'||category===c)&&n.toLowerCase().includes(filter.toLowerCase())),[category,filter]);
function run(){try{setOutput(toolRun(selected,input))}catch(e){setOutput('Error: '+(e instanceof Error?e.message:String(e)));}}
function send(){if(!question.trim())return;const old=history[agent]||[];const reply=answer(agent,question,old.filter(x=>x.role==='you').length);setHistory(h=>({...h,[agent]:[...old,{role:'you',text:question},{role:'agent',text:reply}]}));setQuestion('');}
function loadImage(file?:File){if(!file)return;if(!file.type.startsWith('image/')){setOutput('Selecciona una imagen');return}if(file.size>12_000_000){setOutput('Máximo 12 MB por imagen');return}const r=new FileReader();r.onload=()=>{setImage(String(r.result));setImageName(file.name)};r.readAsDataURL(file);}
function saveImage(){const img=new Image();img.onload=()=>{const c=document.createElement('canvas');c.width=img.naturalWidth;c.height=img.naturalHeight;const ctx=c.getContext('2d');if(!ctx)return;ctx.filter='brightness('+brightness+'%) contrast('+contrast+'%) saturate('+saturation+'%)';ctx.drawImage(img,0,0);const a=document.createElement('a');a.download='belentani-lab-'+imageName.replace(/\.[^.]+$/,'')+'.png';a.href=c.toDataURL('image/png');a.click();};img.src=image;}
const shell:React.CSSProperties={background:'linear-gradient(140deg,#10060c,#030304 42%,#13050b)',color:'#f5eaf0',minHeight:'100vh',fontFamily:'Inter,system-ui,sans-serif',padding:'clamp(18px,4vw,54px)'};
const panel:React.CSSProperties={background:'rgba(25,12,20,.67)',backdropFilter:'blur(20px)',border:'1px solid rgba(255,97,136,.18)',borderRadius:22,padding:22};
const btn:React.CSSProperties={background:'rgba(255,26,73,.12)',border:'1px solid rgba(255,95,130,.32)',borderRadius:11,color:'#f9eef2',padding:'11px 14px',cursor:'pointer'};
const field:React.CSSProperties={background:'#0d0b10',border:'1px solid #51303e',borderRadius:12,color:'white',padding:12,width:'100%',font:'inherit'};
return <main style={shell}><style>{'a{color:inherit} button:hover{border-color:#ff547b!important} textarea:focus,input:focus{outline:1px solid #ff547b} .lab-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:12px}.lab-columns{display:grid;grid-template-columns:minmax(240px,360px) 1fr;gap:18px}@media(max-width:750px){.lab-columns{grid-template-columns:1fr}}'}</style>
<header style={{maxWidth:1250,margin:'0 auto 28px'}}><Link href="/" style={{fontSize:12,letterSpacing:3,textDecoration:'none',opacity:.72}}>← REGRESAR A LA GALAXIA</Link><div style={{letterSpacing:5,color:'#ff547b',fontSize:12,marginTop:32}}>BELENTANI · JUDAS ERA</div><h1 style={{fontSize:'clamp(44px,7vw,94px)',lineHeight:1,letterSpacing:-4,margin:'15px 0'}}>AI <span style={{color:'#ff315f'}}>LAB</span></h1><p style={{maxWidth:670,lineHeight:1.75,color:'#cbb9c2'}}>Laboratorio abierto. Herramientas reales ejecutadas en tu navegador, cinco interlocutores del universo y acceso a modelos abiertos. Sin cuentas, sin claves API, sin ficción tecnológica disfrazada de inferencia.</p></header>
<nav aria-label="Secciones del laboratorio" style={{maxWidth:1250,margin:'0 auto 23px',display:'flex',flexWrap:'wrap',gap:10}}>{([['tools','HERRAMIENTAS'],['agents','AGENTES DEL LORE'],['open','MODELOS ABIERTOS']] as const).map(([key,label])=><button key={key} type="button" aria-pressed={tab===key} onClick={()=>setTab(key)} style={{...btn,background:tab===key?'#7f1538':btn.background}}>{label}</button>)}</nav>
<section style={{maxWidth:1250,margin:'0 auto'}}>
{tab==='tools'&&<><div style={{...panel,marginBottom:18}}><div style={{display:'flex',flexWrap:'wrap',gap:8,marginBottom:12}}>{[['all','TODAS'],['text','TEXTO'],['code','DATOS'],['design','DISEÑO'],['lore','JUDAS']].map(([id,label])=><button key={id} onClick={()=>setCategory(id)} style={{...btn,opacity:category===id?1:.55}}>{label}</button>)}</div><input aria-label="Buscar herramienta" placeholder="Busca entre 24 herramientas…" style={field} value={filter} onChange={e=>setFilter(e.target.value)}/><p style={{opacity:.55,fontSize:12}}>24 utilidades nativas · procesamiento local · ninguna requiere servicio externo</p></div><div className="lab-columns"><div className="lab-grid" style={{gridTemplateColumns:'repeat(auto-fit,minmax(135px,1fr))',alignContent:'start'}}>{visible.map(([n])=><button key={n} style={{...btn,textAlign:'left',minHeight:70,background:selected===n?'#72112b':btn.background}} onClick={()=>{setSelected(n);setOutput('');}}>{n}</button>)}</div><div style={panel}><h2 style={{marginTop:0}}>{selected}</h2><label htmlFor="lab-data" style={{display:'block',marginBottom:9,color:'#d4aebd'}}>Entrada</label><textarea id="lab-data" style={{...field,resize:'vertical',minHeight:160}} value={input} onChange={e=>setInput(e.target.value)} placeholder="Escribe o pega material para procesar…"/><div style={{display:'flex',gap:8,margin:'12px 0'}}><button style={btn} onClick={run}>EJECUTAR</button><button style={btn} onClick={()=>{setInput('');setOutput('')}}>LIMPIAR</button></div><label htmlFor="lab-output" style={{display:'block',marginBottom:9}}>Resultado</label><textarea id="lab-output" readOnly style={{...field,minHeight:165,whiteSpace:'pre-wrap'}} value={output}/><button style={{...btn,marginTop:10}} onClick={()=>navigator.clipboard?.writeText(output)}>COPIAR RESULTADO</button></div></div>
<div style={{...panel,marginTop:18}}><h2>VISION WORKSHOP</h2><p style={{color:'#cdb6c3'}}>Carga una imagen, aplica filtros reales con Canvas y exporta PNG. El archivo permanece en tu dispositivo.</p><input ref={fileRef} type="file" accept="image/*" onChange={e=>loadImage(e.target.files?.[0])}/>{image&&<><img alt="Vista previa editada" src={image} style={{maxWidth:'100%',maxHeight:360,display:'block',margin:'20px auto',filter:'brightness('+brightness+'%) contrast('+contrast+'%) saturate('+saturation+'%)'}}/>{[['BRILLO',brightness,setBrightness],['CONTRASTE',contrast,setContrast],['SATURACIÓN',saturation,setSaturation]].map(([name,value,set])=><label key={String(name)} style={{display:'block',marginTop:15}}>{String(name)} · {Number(value)}% <input style={{width:'100%'}} type="range" min="0" max="200" value={Number(value)} onChange={e=>(set as (n:number)=>void)(Number(e.target.value))}/></label>)}<button style={{...btn,marginTop:20}} onClick={saveImage}>EXPORTAR PNG PROCESADO</button></>}</div></>}
{tab==='agents'&&<div className="lab-columns"><div style={panel}><h2 style={{marginTop:0}}>LAS CINCO VOCES</h2><p style={{opacity:.65,fontSize:13}}>Son personajes interactivos con respuestas narrativas deterministas. No se presentan como un modelo de IA.</p>{(Object.keys(agents) as Agent[]).map(a=><button key={a} onClick={()=>setAgent(a)} style={{...btn,width:'100%',textAlign:'left',margin:'5px 0',background:agent===a?'#781432':btn.background}}><strong>{a}</strong><span style={{display:'block',fontSize:11,opacity:.7,marginTop:4}}>{agents[a].role}</span></button>)}</div><div style={{...panel,minHeight:480,display:'flex',flexDirection:'column'}}><h2 style={{margin:'0 0 4px'}}>{agent}</h2><p style={{color:'#cba9b9'}}>{agents[agent].intro}</p><div aria-live="polite" style={{flex:1,maxHeight:420,overflowY:'auto',padding:'10px 0'}}>{(history[agent]||[]).map((m,i)=><div key={i} style={{margin:'12px 0',padding:14,borderRadius:14,background:m.role==='you'?'#3b1526':'#171018',marginLeft:m.role==='you'?24:0,marginRight:m.role==='agent'?24:0,whiteSpace:'pre-wrap'}}><small style={{opacity:.55}}>{m.role==='you'?'VISITANTE':agent}</small><div>{m.text}</div></div>)}</div><form onSubmit={e=>{e.preventDefault();send()}} style={{display:'flex',gap:8,marginTop:20}}><input value={question} onChange={e=>setQuestion(e.target.value)} style={field} maxLength={500} placeholder={'Habla con '+agent} aria-label="Mensaje del visitante"/><button style={btn} type="submit">ENVIAR</button></form><div style={{display:'flex',gap:8,marginTop:10,flexWrap:'wrap'}}><button style={btn} onClick={()=>{if('speechSynthesis' in window){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance((history[agent]||[]).filter(m=>m.role==='agent').slice(-1)[0]?.text||agents[agent].intro))}}}>ESCUCHAR VOZ</button><button style={btn} onClick={()=>setHistory(h=>({...h,[agent]:[]}))}>REINICIAR CONVERSACIÓN</button></div></div></div>}
{tab==='open'&&<><div style={panel}><h2 style={{marginTop:0}}>OPEN MODEL DIRECTORY</h2><p style={{lineHeight:1.7,color:'#cdb6c3'}}>Aquí se accede a herramientas y modelos de terceros, que pueden requerir descarga, capacidad WebGPU, conexión o tener cuotas propias. El laboratorio no solicita ni almacena tokens. Un enlace a un modelo no se hace pasar por generación propia.</p></div><div className="lab-grid" style={{marginTop:18}}>{hf.map(x=><a key={x.name} href={x.url} target="_blank" rel="noreferrer" style={{...panel,display:'block',textDecoration:'none'}}><small style={{color:'#ff6289',letterSpacing:2}}>OPEN SOURCE / EXTERNAL ↗</small><h2>{x.name}</h2><p style={{color:'#c6b0bb'}}>{x.detail}</p></a>)}</div></>}
</section><footer style={{maxWidth:1250,margin:'40px auto 0',opacity:.5,fontSize:12}}>JUDAS ERA · La ficción es ficción. Las herramientas locales procesan en el navegador. Los servicios externos siguen sus propias condiciones.</footer></main>
}